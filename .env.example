# Server-side simple-jev connection. Replace localhost with your PC's address.
# Use HTTPS only if TLS is configured on the service.
JEV_BASE_URL=http://127.0.0.1:8000
JEV_MODEL=Qwen/Qwen3.5-0.8B
# Per-request classifier timeout in milliseconds (default 60000).
JEV_TIMEOUT_MS=
# 1 marks results as test-service output and requires a separate DATABASE_PATH. Leave unset for real use.
JEV_TEST_MODE=

# Paper search source: openalex (default) or semantic-scholar.
PAPER_SOURCE=openalex
# Free OpenAlex key from an account at https://openalex.org: $1/day of usage (about 1,000
# searches), resetting at midnight UTC. Without it, about $0.10/day (about 100 searches).
OPENALEX_API_KEY=
# Semantic Scholar key (request at https://www.semanticscholar.org/product/api#api-key-form).
# Without it, requests share a public rate limit that often returns HTTP 429.
SEMANTIC_SCHOLAR_API_KEY=
